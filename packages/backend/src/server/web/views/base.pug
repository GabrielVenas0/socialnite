block vars

block loadClientEntry
	- const entry = config.frontendEntry;
	- const baseUrl = config.url;

doctype html

//
	 Social Nite
	 Software livre sob a licença AGPL-3.0, construído sobre o Misskey.


html

	head
		meta(charset='utf-8')
		meta(name='application-name' content='Social Nite')
		meta(name='referrer' content='origin')
		meta(name='theme-color' content= themeColor || '#0972c4')
		meta(name='theme-color-orig' content= themeColor || '#0972c4')
		meta(property='og:site_name' content= instanceName || 'Social Nite')
		meta(property='instance_url' content= instanceUrl)
		meta(name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover')
		meta(name='format-detection' content='telephone=no,date=no,address=no,email=no,url=no')
		meta(name='mobile-web-app-capable' content='yes')
		meta(name='apple-mobile-web-app-capable' content='yes')
		meta(name='apple-mobile-web-app-status-bar-style' content='black-translucent')
		meta(name='apple-mobile-web-app-title' content= instanceName || 'Social Nite')
		link(rel='icon' href= icon || '/favicon.ico')
		link(rel='apple-touch-icon' href= appleTouchIcon || '/apple-touch-icon.png')
		link(rel='manifest' href='/manifest.json')
		link(rel='search' type='application/opensearchdescription+xml' title=(title || "Social Nite") href=`${baseUrl}/opensearch.xml`)
		//- Só pré-carrega imagens que a administração configurou. Antes havia um
		//- padrão externo (xn--931a.moe, a mascote do Misskey): todo visitante
		//- baixava três imagens de um site de terceiros a cada página, sem que
		//- elas aparecessem em lugar nenhum.
		if serverErrorImageUrl
			link(rel='prefetch' href=serverErrorImageUrl)
		if infoImageUrl
			link(rel='prefetch' href=infoImageUrl)
		if notFoundImageUrl
			link(rel='prefetch' href=notFoundImageUrl)

		if !config.frontendManifestExists
				script(type="module" src="/vite/@vite/client")

		if Array.isArray(entry.css)
			each href in entry.css
				link(rel='stylesheet' href=`/vite/${href}`)

		title
			block title
				= title || 'Social Nite'

		if noindex
			meta(name='robots' content='noindex')

		//- Texto e imagem da prévia do link (WhatsApp, Telegram, redes sociais).
		//- Sem descrição configurada, aparecia o slogan do Misskey em inglês; sem
		//- imagem, a prévia saía vazia. O ícone vai com endereço absoluto porque
		//- os robôs de prévia não resolvem caminho relativo.
		block desc
			meta(name='description' content= desc || 'Social Nite — Rede Social Interativa')

		block meta

		block og
			meta(property='og:title'       content= title || 'Social Nite')
			meta(property='og:description' content= desc || 'Social Nite — Rede Social Interativa')
			meta(property='og:image'       content= img || icon || `${instanceUrl}/static-assets/icons/512.png`)
			meta(property='twitter:card'   content='summary')

		style
			include ../style.css

		script.
			var VERSION = "#{version}";
			var CLIENT_ENTRY = !{JSON.stringify(entry.file)};

		script(type='application/json' id='misskey_meta' data-generated-at=now)
			!= metaJson

		script(type='application/json' id='misskey_clientCtx' data-generated-at=now)
			!= clientCtx

		script
			include ../boot.js

	body
		noscript: p
			| Por favor, ative o JavaScript
			br
			| Please turn on your JavaScript
		div#splash
			img#splashIcon(src= icon || '/static-assets/splash.png')
			div#splashSpinner
				<svg class="spinner bg" viewBox="0 0 152 152" xmlns="http://www.w3.org/2000/svg">
					<g transform="matrix(1,0,0,1,12,12)">
						<circle cx="64" cy="64" r="64" style="fill:none;stroke:currentColor;stroke-width:24px;"/>
					</g>
				</svg>
				<svg class="spinner fg" viewBox="0 0 152 152" xmlns="http://www.w3.org/2000/svg">
					<g transform="matrix(1,0,0,1,12,12)">
						<path d="M128,64C128,28.654 99.346,0 64,0C99.346,0 128,28.654 128,64Z" style="fill:none;stroke:currentColor;stroke-width:24px;"/>
					</g>
				</svg>
		block content
